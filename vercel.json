{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/daily-digest",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/pinterest-post?action=post-next",
      "schedule": "0 6,9,12,15,18 * * *"
    }
  ]
}

